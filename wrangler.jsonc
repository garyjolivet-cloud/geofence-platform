{
  "name": "geofence-platform",
  "compatibility_date": "2026-06-01",
  "main": "./backend/worker.js",
  "vars": {
    "ORG_ID": "chase-life",
    "ALLOWED_ORIGIN": "https://geofence-platform.gary-jolivet.workers.dev"
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geofence-db",
      "database_id": "d1b9f6e3-d70b-4bf0-a91e-9385f886fa73",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "geofence-audio"
    },
    {
      "binding": "MODELS",
      "bucket_name": "geofence-models"
    },
    {
      "binding": "TILES",
      "bucket_name": "geofence-tiles"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    // */30 (was */5): presence rows are filtered by freshness at read time
    //   (GET /api/presence, /api/presence/friends both `WHERE updated_at > ?`),
    //   so the cleanup DELETEs are pure table-size housekeeping — running them
    //   6x less often has no user-facing effect. cleanupOldRecordings is
    //   day-granularity anyway.
    // 0 */6 (was 0 *): the weather cache only feeds a game's Conditions screen
    //   + LLM context; 6h-stale is fine and there's a manual POST /api/weather
    //   refresh. scrapeWeather() also self-skips deep summer (see scheduled()).
    "crons": ["*/30 * * * *", "0 */6 * * *", "0 15 * * *"]
  }
}
